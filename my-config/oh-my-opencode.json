{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "bailian-coding-plan/kimi-k2.5",
      "fallback_models": [
        "bailian-coding-plan/glm-5",
        "bailian-coding-plan/qwen3.5-plus",
        "bailian-coding-plan/qwen3-max-2026-01-23"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.2-codex",
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3-coder-plus"
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.2",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "bailian-coding-plan/kimi-k2.5"
      ]
    },
    "librarian": {
      "model": "minimax/MiniMax-M2.5",
      "fallback_models": [
        "bailian-coding-plan/glm-5",
        "openai/codex-mini-latest"
      ]
    },
    "explore": {
      "model": "minimax/MiniMax-M2.5-highspeed",
      "fallback_models": [
        "minimax/MiniMax-M2.5",
        "openai/codex-mini-latest"
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.2",
      "variant": "high"
    },
    "prometheus": {
      "model": "openai/gpt-5.2",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "bailian-coding-plan/kimi-k2.5"
      ]
    },
    "metis": {
      "model": "openai/gpt-5.2",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "bailian-coding-plan/kimi-k2.5"
      ]
    },
    "momus": {
      "model": "openai/gpt-5.2",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex"
      ]
    },
    "atlas": {
      "model": "bailian-coding-plan/kimi-k2.5",
      "fallback_models": [
        "openai/gpt-5.2",
        "bailian-coding-plan/glm-5"
      ]
    },
    "scribe": {
      "model": "bailian-coding-plan/kimi-k2.5",
      "fallback_models": [
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3.5-plus"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "bailian-coding-plan/glm-5",
      "fallback_models": [
        "openai/gpt-5.2",
        "bailian-coding-plan/kimi-k2.5"
      ]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.3-codex",
      "variant": "xhigh",
      "fallback_models": [
        "openai/gpt-5.2-codex",
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3-max-2026-01-23"
      ]
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.2-codex",
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3-coder-plus"
      ]
    },
    "artistry": {
      "model": "bailian-coding-plan/kimi-k2.5",
      "fallback_models": [
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3.5-plus"
      ]
    },
    "quick": {
      "model": "minimax/MiniMax-M2.5-highspeed",
      "fallback_models": [
        "minimax/MiniMax-M2.5",
        "openai/codex-mini-latest"
      ]
    },
    "unspecified-low": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.2-codex",
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3-coder-plus"
      ]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.2",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "openai/gpt-5.2-codex",
        "bailian-coding-plan/qwen3-max-2026-01-23"
      ]
    },
    "writing": {
      "model": "bailian-coding-plan/kimi-k2.5",
      "fallback_models": [
        "openai/gpt-5.2",
        "bailian-coding-plan/qwen3.5-plus"
      ]
    },
    "deep-ms": {
      "model": "bailian-coding-plan/qwen3-coder-plus",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "openai/gpt-5.2"
      ]
    },
    "ultrabrain-ms": {
      "model": "bailian-coding-plan/qwen3-max-2026-01-23",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "openai/gpt-5.2"
      ]
    }
  },
  "background_task": {
    "providerConcurrency": {
      "minimax": 10,
      "bailian-coding-plan": 10,
      "openai": 3,
      "opencode": 10
    },
    "modelConcurrency": {
      "minimax/MiniMax-M2.5-highspeed": 10,
      "minimax/MiniMax-M2.5": 10,
      "openai/gpt-5.3-codex": 2,
      "openai/gpt-5.2": 3,
      "bailian-coding-plan/kimi-k2.5": 5,
      "bailian-coding-plan/glm-5": 5
    }
  },
  "lsp": {
    "remark-markdown": {
      "command": ["remark-language-server", "--stdio"],
      "extensions": [".md"]
    }
  }
}
